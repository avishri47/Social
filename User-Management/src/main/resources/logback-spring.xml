<appender name="SPLUNK" class="com.splunk.logging.HttpEventCollectorLogbackAppender">

    <url>https://localhost:8088</url>
    <token>2ff4989f-cd5c-45f8-a946-94abba1fefea</token>

    <index>main</index>
    <source>spring-boot-app</source>
    <sourcetype>_json</sourcetype>

    <messageFormat>json</messageFormat>

    <batch_size_count>5</batch_size_count>
    <batch_size_interval>2</batch_size_interval>

    <disableCertificateValidation>true</disableCertificateValidation>

    <!-- ✅ REQUIRED FIX -->
    <layout class="ch.qos.logback.classic.PatternLayout">
        <pattern>
            {"timestamp":"%d","level":"%-5level","thread":"%thread","logger":"%logger","message":"%msg"}%n
        </pattern>
    </layout>

</appender>